# Required for local development, Supabase, and Vercel
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Required in production. Generate a long random value.
# Example command: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"

# Public website URL used for sitemap/canonical sharing links
NEXT_PUBLIC_SITE_URL="https://your-vercel-domain.vercel.app"

# Optional: Paystack secure server-side integration
# Never expose this value in client-side code.
PAYSTACK_SECRET_KEY="sk_test_or_live_xxxxxxxxxxxxxxxxx"

# Optional: used by scripts/create-admin.ts for production admin setup
ADMIN_NAME="Church Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"
ADMIN_ROLE="super_admin"
