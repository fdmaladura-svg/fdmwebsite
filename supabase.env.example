# Copy this file to `.env.supabase` (never commit the real one) and
# fill in your real connection string. For Vercel, add the same value
# as the DATABASE_URL environment variable there.
#
# Tip: if your password contains special characters (@ ! # $ etc.),
# URL-encode them for some database tools, e.g.:
#   HE!S_gVeK8@ibiC  ->  HE%21S_gVeK8%40ibiC
# (the pg driver used by this app accepts the plain password too)

DATABASE_URL="postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"
